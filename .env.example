# ==============================================================================
# FinanceFlow Configuration File
# Salin file ini menjadi '.env' dan isi GEMINI_API_KEY Anda
# ==============================================================================

# Dapatkan API Key gratis di: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini yang digunakan (rekomendasi: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash
